# Add these entries to the existing project .env; preserve unrelated settings.
# Do not commit .env. No printer address is assumed.
# The reserved Machine-network address belongs only in the local .env.
# Supported: KEY=value, optionally matching single/double quotes.
# Use whole-line comments; no inline comments, expansion, or multiline values.
LJ3_IP=
LJ3_PORT=3000
LJ3_TIMEOUT_SECONDS=3
